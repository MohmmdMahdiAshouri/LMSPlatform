    <ProjectReference Include="..\..\Shared\LMS.Shared.Infrastructure\LMS.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Shared\LMS.Shared.ErrorHandling\LMS.Shared.ErrorHandling.csproj" />
    <ProjectReference Include="..\..\Shared\LMS.Shared.ResponseHandling\LMS.Shared.ResponseHandling.csproj" />
    <ProjectReference Include="..\..\LMS.Identity\LMS.Identity.Authentication\Domain\LMS.Identity.Authentication.Domain.csproj" />
    <ProjectReference Include="..\..\LMS.Identity\LMS.Identity.Authentication\Application\LMS.Identity.Authentication.Application.csproj" />
    <ProjectReference Include="..\..\LMS.Identity\LMS.Identity.Authentication\Infrastructure\LMS.Identity.Authentication.Infrastructure.csproj" />
    <ProjectReference Include="..\..\LMS.Identity\LMS.Identity.Authentication\WebApi\LMS.Identity.Authentication.WebApi.csproj" />
  </ItemGroup>

</Project>
